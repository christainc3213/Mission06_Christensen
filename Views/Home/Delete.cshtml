@model MovieCollectionApp.Models.Movie

@{
    ViewData["Title"] = "Delete Movie";
}

<h2>Delete Movie</h2>

<h4>Are you sure you want to delete this movie?</h4>
<dl class="row">
    <dt class = "col-sm-2">Title</dt>
    <dd class = "col-sm-10">@Model.Title</dd>
    <dt class="col-sm-2">Year</dt>
    <dd class="col-sm-10">@Model.Year</dd>
</dl>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="MovieId" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="MovieList" class="btn btn-secondary">Cancel</a>
</form>