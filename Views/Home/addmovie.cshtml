@model MovieCollectionApp.Models.Movie

@{
    ViewData["Title"] = "Add a New Movie";
}

<h2>Add a New Movie</h2>

<form asp-action="Addmovie" method="post">

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <!-- Category dropdown -->
    <div class="form-group">
        <label asp-for="CategoryId">Category</label>
        <select asp-for="CategoryId" 
                asp-items="ViewBag.Categories" 
                class="form-control">
            <option value="">--Select Category--</option>
        </select>
        <!-- Show error if none selected -->
        <span asp-validation-for="CategoryId" class="text-danger"></span>
    </div>
    <br>

    <!-- Title -->
    <div class="form-group">
        <label asp-for="Title"></label>
        <input asp-for="Title" class="form-control" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>
    <br>
    
    <!-- Year -->
    <div class="form-group">
        <label asp-for="Year"></label>
        <input asp-for="Year" class="form-control" type="number" min="1888" />
        <span asp-validation-for="Year" class="text-danger"></span>
    </div>
    <br>

    <!-- Director -->
    <div class="form-group">
        <label asp-for="Director"></label>
        <input asp-for="Director" class="form-control" />
        <span asp-validation-for="Director" class="text-danger"></span>
    </div>
    <br>

    <!-- Rating -->
    <div class="form-group">
        <label asp-for="Rating"></label>
        <select asp-for="Rating" class="form-control">
            <option value="">--Select Rating--</option>
            <option>G</option>
            <option>PG</option>
            <option>PG-13</option>
            <option>R</option>
            <option>NC-17</option>
        </select>
        <span asp-validation-for="Rating" class="text-danger"></span>
    </div>
    <br>

    <!-- Edited -->
    <div class="form-check">
        <input asp-for="Edited" class="form-check-input" />
        <label asp-for="Edited" class="form-check-label"></label>
    </div>

    <!-- CopiedToPlex -->
    <div class="form-check">
        <input asp-for="CopiedToPlex" class="form-check-input" />
        <label asp-for="CopiedToPlex" class="form-check-label"></label>
    </div>
    <br>

    <!-- LentTo -->
    <div class="form-group">
        <label asp-for="LentTo"></label>
        <input asp-for="LentTo" class="form-control" />
        <span asp-validation-for="LentTo" class="text-danger"></span>
    </div>
    <br>

    <!-- Notes -->
    <div class="form-group">
        <label asp-for="Notes"></label>
        <input asp-for="Notes" class="form-control" />
        <span asp-validation-for="Notes" class="text-danger"></span>
    </div>
    <br>

    <button type="submit" class="btn btn-primary">Add Movie</button>
    <br>

</form>
